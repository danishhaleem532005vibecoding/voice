# ==============================================
# PAKVOICE NEWS — ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# ---- DATABASE ---------------------------------
# PostgreSQL recommended for production.
# For local dev with SQLite: "file:./dev.db"
DATABASE_URL="postgresql://user:password@localhost:5432/pakvoice"

# ---- NEXTAUTH ---------------------------------
NEXTAUTH_SECRET="change-me-to-a-random-32+-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- NEWS API ---------------------------------
# Get free key at: https://newsapi.org
# Leave blank to use GDELT/RSS fallback only.
NEWS_API_KEY=""

# ---- GDELT ------------------------------------
# Free, no key required. Change URL only if GDELT moves.
GDELT_API_BASE_URL="https://api.gdeltproject.org"

# ---- GOOGLE TRANSLATE -------------------------
# Get key at: https://console.cloud.google.com
# Leave blank to use free MyMemory translation fallback.
GOOGLE_TRANSLATE_API_KEY=""

# ---- GOOGLE TEXT-TO-SPEECH --------------------
# Get key at: https://console.cloud.google.com
# Leave blank to use browser SpeechSynthesis fallback.
GOOGLE_TTS_API_KEY=""

# ---- OPENAI (Optional AI Summarization) -------
# Leave blank to disable AI summarization.
OPENAI_API_KEY=""

# ---- GEMINI (Alternative AI) ------------------
GEMINI_API_KEY=""

# ---- WEATHER ----------------------------------
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# ---- REDIS (Optional Caching) -----------------
# Leave blank to use in-memory/database cache.
REDIS_URL=""

# ---- EMAIL (Newsletter) -----------------------
# Leave blank to disable email sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@pakvoice.com"

# ---- APP CONFIG -------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PakVoice"
NEXT_PUBLIC_APP_TAGLINE="Real-Time Pakistan & World News"

# ---- SECURITY ---------------------------------
# Set to "true" in production ONLY.
ALLOW_DEMO_DATA="true"
NODE_ENV="development"

# ---- ADMIN ------------------------------------
# Initial admin credentials (change immediately after first login).
ADMIN_EMAIL="admin@pakvoice.com"
ADMIN_PASSWORD="change-me-immediately"
